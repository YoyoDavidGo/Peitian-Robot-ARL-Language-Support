    "endwhile": {"type":"logic","desc":"结束 while 循环块","desc_en":"End while block","proto":"endwhile"},
    "for": {"type":"logic","desc":"步进循环","desc_en":"For loop","proto":"for(初始化; bool表达式; 迭代)"},
    "endfor": {"type":"logic","desc":"结束 for 循环块","desc_en":"End for block","proto":"endfor"},
    "repeat": {"type":"logic","desc":"直到型循环起始，先执行后判断","desc_en":"Repeat-until loop (execute-first)","proto":"repeat"},
