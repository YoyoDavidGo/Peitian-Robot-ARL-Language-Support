{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Peitian ARL",
  "scopeName": "source.arl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#functionDefinitions"
    },
    {
      "include": "#crossFileCalls"
    },
    {
      "include": "#systemVariables"
    },
    {
      "include": "#datatypes"
    },
    {
      "include": "#logic"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#builtInFunctions"
    },
    {
      "include": "#parenOnlyFunctions"
    },
    {
      "include": "#variableDeclarations"
    },
    {
      "include": "#genericFunctionCalls"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.arl",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.arl"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.arl"
            }
          }
        },
        {
          "name": "comment.line.double-slash.arl",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.arl"
            }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.arl",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.arl"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.arl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.arl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "name": "meta.function.definition.arl",
          "match": "(?i:(\\bfunc\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(main)\\s*(?=\\())",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.arl"
            },
            "2": {
              "name": "storage.type.return.arl"
            },
            "3": {
              "name": "entity.name.function.main.arl"
            }
          }
        },
        {
          "name": "meta.function.definition.arl",
          "match": "(?i:(\\bfunc\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\())",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.arl"
            },
            "2": {
              "name": "storage.type.return.arl"
            },
            "3": {
              "name": "entity.name.function.user.arl"
            }
          }
        }
      ]
    },
    "crossFileCalls": {
      "patterns": [
        {
          "match": "(?i:\\b([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\())",
          "captures": {
            "1": {
              "name": "entity.name.namespace.arl"
            },
            "2": {
              "name": "punctuation.accessor.arl"
            },
            "3": {
              "name": "entity.name.function.user.arl"
            }
          }
        }
      ]
    },
    "systemVariables": {
      "patterns": [
        {
          "name": "variable.language.system.arl",
          "match": "(?i:(?<![A-Za-z0-9_])\\$[A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "datatypes": {
      "patterns": [
        {
          "name": "storage.type.arl",
          "match": "(?i:\\b(?:modbus_rtu_master|melsec_dev|modbus_dev|compendata|weavedata|tcpforce|double|string|socket|frame|joint|speed|clock|iodev|uint|byte|bool|pose|tool|wobj|slip|jvel|jttq|jtci|int|pos)\\b)"
        }
      ]
    },
    "logic": {
      "patterns": [
        {
          "name": "keyword.control.arl",
          "match": "(?i:\\b(?:endswitch|endwhile|continue|endloop|default|elseif|endfor|repeat|switch|endif|while|until|break|else|loop|case|goto|for|if)\\b)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.arl",
          "match": "(?i:\\b(?:endfunc|return|const|false|void|true|endl|func)\\b)"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "support.function.instruction.arl",
          "match": "(?i:\\b(?:palletcompen|startdetect|startcompen|disableint|toolswitch|startweave|waituntil|startmove|interrupt|enableint|enddetect|endcompen|waittime|stopmove|endweave|restart|trigger|velset|accset|delint|compen|import|movej|pause|timer|print|ccir|jump|exit|scan|ptp|lin|cir|spl)\\b)"
        }
      ]
    },
    "builtInFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.main.arl",
          "match": "(?i:\\bmain\\b(?=\\s*\\())"
        },
        {
          "name": "support.function.builtin.arl",
          "match": "(?i:\\b(?:startbackchannel|pausebackchannel|resetbackchannel|gettoolrot_world|setinterpercent|getinterpercent|channeljointvel|channeltojoint|getwobj_flange|gettooltcp_ref|writeregisters|switchbackarl|channeltopose|channeltcpvel|gettoolrot_3p|savefilejoint|readregisters|channeljoint|getwobj_indi|savefilepose|savejointnow|channelpose|getposetool|getposewobj|setposetool|setposewobj|saveposenow|getwobj_3p|gettool_3p|getbase_3p|renamefile|removefile|gettextstr|writecoils|switcharl|curmpfile|curmpline|curppfile|curppline|ctcpforce|syncwrite|readuntil|clearbuff|readcoils|getintdo|getintdi|addslave|setcycle|getjoint|todouble|ftobytes|bitcheck|bitclear|filesize|clkstart|clkreset|pulsedo|toascii|getpose|poseinv|reltool|tobytes|tofloat|savearl|connect|dnwrite|clkstop|clkread|syncdo|syncao|setpwm|savesv|typeof|assert|cjoint|offset|strlen|substr|bitset|bitlcs|bitrcs|accept|dnread|setdo|setao|getdo|getdi|getai|getao|ctime|cdate|setip|getip|atan2|pow10|log10|floor|hypot|trunc|frexp|ldexp|cpose|cjttq|cjtci|toint|tostr|write|close|init|main|sqrt|asin|acos|atan|sinh|cosh|tanh|ceil|fmod|modf|rand|norm|read|open|abs|sin|cos|tan|exp|pow|log)\\b(?=\\s*\\())"
        }
      ]
    },
    "parenOnlyFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.paren.arl",
          "match": "(?i:\\b(?:stoend|t|p|s)\\b(?=\\s*\\())"
        }
      ]
    },
    "variableDeclarations": {
      "patterns": [
        {
          "match": "(?i:(?:\\bconst\\b\\s+)?\\b(?:modbus_rtu_master|melsec_dev|modbus_dev|compendata|weavedata|tcpforce|double|string|socket|frame|joint|speed|clock|iodev|uint|byte|bool|pose|tool|wobj|slip|jvel|jttq|jtci|int|pos)\\b\\s+([A-Za-z_][A-Za-z0-9_]*))",
          "captures": {
            "1": {
              "name": "variable.other.definition.arl"
            }
          }
        }
      ]
    },
    "genericFunctionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.user.arl",
          "match": "(?i:\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\())"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.arl",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f]+|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.arl",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
