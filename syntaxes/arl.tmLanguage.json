{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Peitian ARL",
  "scopeName": "source.arl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#functionDefinitions"
    },
    {
      "include": "#crossFileCalls"
    },
    {
      "include": "#systemVariables"
    },
    {
      "include": "#datatypes"
    },
    {
      "include": "#logic"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#motionInstructions"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#builtInFunctions"
    },
    {
      "include": "#parenOnlyFunctions"
    },
    {
      "include": "#variableDeclarations"
    },
    {
      "include": "#genericFunctionCalls"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.arl",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.arl"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.arl"
            }
          }
        },
        {
          "name": "comment.line.double-slash.arl",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.arl"
            }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.arl",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.arl"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.arl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.arl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "name": "meta.function.definition.arl",
          "match": "(?i:(\\bfunc\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(main)\\s*(?=\\())",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.arl"
            },
            "2": {
              "name": "storage.type.return.arl"
            },
            "3": {
              "name": "entity.name.function.main.arl"
            }
          }
        },
        {
          "name": "meta.function.definition.arl",
          "match": "(?i:(\\bfunc\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\())",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.arl"
            },
            "2": {
              "name": "storage.type.return.arl"
            },
            "3": {
              "name": "entity.name.function.user.arl"
            }
          }
        }
      ]
    },
    "crossFileCalls": {
      "patterns": [
        {
          "match": "(?i:\\b([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\())",
          "captures": {
            "1": {
              "name": "entity.name.namespace.arl"
            },
            "2": {
              "name": "punctuation.accessor.arl"
            },
            "3": {
              "name": "entity.name.function.user.arl"
            }
          }
        }
      ]
    },
    "systemVariables": {
      "patterns": [
        {
          "name": "variable.language.system.arl",
          "match": "(?i:(?<![A-Za-z0-9_])\\$[A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "datatypes": {
      "patterns": [
        {
          "name": "storage.type.arl",
          "match": "(?i:\\b(?:modbus_rtu_master|palletcompenpara|compendatajoint|toolinertiapara|inertia_tensor|centroid_pos|weaverotaxis|controlmode|compendata|melsec_dev|modbus_dev|weaveshape|weavedata|num_base|stopbits|stoptype|tcpforce|control|printto|double|parity|socket|string|clock|frame|iodev|joint|speed|bool|byte|jtci|jttq|jvel|pose|slip|tool|uint|void|wobj|int|pos)\\b)"
        }
      ]
    },
    "logic": {
      "patterns": [
        {
          "name": "keyword.control.arl",
          "match": "(?i:\\b(?:endswitch|continue|endwhile|default|endloop|elseif|endfor|repeat|return|switch|break|endif|until|while|case|else|goto|loop|for|if)\\b)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.arl",
          "match": "(?i:\\b(?:endfunc|const|func)\\b)"
        }
      ]
    },
    "motionInstructions": {
      "patterns": [
        {
          "begin": "(?i:\\b(?:movej|ccir|jump|cir|lin|ptp|spl)\\b)",
          "beginCaptures": {
            "0": {
              "name": "support.function.instruction.arl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "constant.numeric.arl",
              "match": "(?<![A-Za-z0-9_])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?=(?i:mm(?:/s)?)(?![A-Za-z0-9_]))"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "support.function.instruction.arl",
          "match": "(?i:\\b(?:startcompen|startdetect|disableint|startweave|toolswitch|enableint|endcompen|enddetect|interrupt|startmove|waituntil|endweave|stopmove|waittime|restart|trigger|accset|compen|delint|import|velset|movej|pause|print|timer|ccir|exit|jump|scan|cir|lin|ptp|spl)\\b)"
        }
      ]
    },
    "builtInFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.main.arl",
          "match": "(?i:\\bmain\\b(?=\\s*\\())"
        },
        {
          "name": "support.function.builtin.arl",
          "match": "(?i:\\b(?:gettoolrot_world|pausebackchannel|resetbackchannel|startbackchannel|channeljointvel|getinterpercent|setinterpercent|channeltojoint|gettooltcp_ref|getwobj_flange|writeregisters|channeltcpvel|channeltopose|gettoolrot_3p|readregisters|savefilejoint|switchbackarl|channeljoint|getwobj_indi|palletcompen|savefilepose|savejointnow|channelpose|getposetool|getposewobj|saveposenow|setposetool|setposewobj|getbase_3p|gettextstr|gettool_3p|getwobj_3p|removefile|renamefile|writecoils|clearbuff|ctcpforce|curmpfile|curmpline|curppfile|curppline|readcoils|readuntil|switcharl|syncwrite|addslave|bitcheck|bitclear|clkreset|clkstart|filesize|ftobytes|geterror|getintdi|getintdo|getjoint|setcycle|todouble|clkread|clkstop|connect|dnwrite|getpose|poseinv|pulsedo|reltool|savearl|toascii|tobytes|tofloat|accept|assert|bitlcs|bitrcs|bitset|cjoint|dnread|offset|savesv|setpwm|strlen|substr|syncao|syncdo|typeof|atan2|cdate|cjtci|cjttq|close|cpose|ctime|floor|frexp|getai|getao|getdi|getdo|getip|hypot|ldexp|log10|pow10|setao|setdo|setip|toint|tostr|trunc|write|acos|asin|atan|ceil|cosh|fmod|init|main|modf|norm|open|rand|read|sinh|sqrt|tanh|abs|cos|exp|log|pow|sin|tan)\\b)(?=\\s*\\()"
        }
      ]
    },
    "parenOnlyFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.paren.arl",
          "match": "(?i:\\b(?:stoend|p|s|t)\\b)(?=\\s*\\()"
        }
      ]
    },
    "variableDeclarations": {
      "patterns": [
        {
          "match": "(?i:(?:\\bconst\\b\\s+)?\\b(?:modbus_rtu_master|palletcompenpara|compendatajoint|toolinertiapara|inertia_tensor|centroid_pos|weaverotaxis|controlmode|compendata|melsec_dev|modbus_dev|weaveshape|weavedata|num_base|stopbits|stoptype|tcpforce|control|printto|double|parity|socket|string|clock|frame|iodev|joint|speed|bool|byte|jtci|jttq|jvel|pose|slip|tool|uint|void|wobj|int|pos)\\b\\s+([A-Za-z_][A-Za-z0-9_]*))",
          "captures": {
            "1": {
              "name": "variable.other.definition.arl"
            }
          }
        }
      ]
    },
    "genericFunctionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.user.arl",
          "match": "(?i:\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\())"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.arl",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f]+|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.arl",
          "match": "[()\\[\\]{}]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.arl",
          "match": "(?i:\\b(?:false|endl|true|pi)\\b)"
        }
      ]
    }
  }
}
