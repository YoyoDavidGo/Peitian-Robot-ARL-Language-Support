{
  "$schema": "vscode://schemas/color-theme",
  "name": "Peitian ARL Black",
  "type": "dark",
  "colors": {
    "foreground": "#c8d0d4",
    "descriptionForeground": "#6a7278",
    "focusBorder": "#3994BCB3",
    "activityBar.background": "#191a1b",
    "activityBar.foreground": "#c8d0d4",
    "activityBar.inactiveForeground": "#6a7278",
    "activityBar.border": "#2e3033",
    "sideBar.background": "#191a1b",
    "sideBar.foreground": "#c8d0d4",
    "sideBar.border": "#2e3033",
    "titleBar.activeBackground": "#191a1b",
    "titleBar.activeForeground": "#6a7278",
    "titleBar.border": "#2e3033",
    "editor.background": "#121314",
    "editor.foreground": "#c8d0d4",
    "editorLineNumber.foreground": "#555a60",
    "editorLineNumber.activeForeground": "#c8d0d4",
    "editorCursor.foreground": "#c8d0d4",
    "editor.selectionBackground": "#276782dd",
    "editor.inactiveSelectionBackground": "#27678260",
    "editor.lineHighlightBackground": "#242526",
    "editorWhitespace.foreground": "#8C8C8C4D",
    "editorIndentGuide.background1": "#8384854D",
    "editorIndentGuide.activeBackground1": "#838485",
    "editorBracketMatch.background": "#3994BC55",
    "editorBracketMatch.border": "#2A2B2C",
    "editorGroupHeader.tabsBackground": "#202122",
    "tab.activeBackground": "#121314",
    "tab.activeForeground": "#c8d0d4",
    "tab.inactiveBackground": "#191a1b",
    "tab.inactiveForeground": "#6a7278",
    "tab.border": "#2e3033",
    "panel.background": "#191a1b",
    "panel.border": "#2e3033",
    "statusBar.background": "#121314",
    "statusBar.foreground": "#6a7278",
    "statusBar.border": "#2e3033"
  },
  "tokenColors": [
    {
      "name": "VS Code base - comments",
      "scope": "comment",
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "VS Code base - strings",
      "scope": "string",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "VS Code base - numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "VS Code base - control flow",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "name": "VS Code base - keywords",
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "VS Code base - types",
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "VS Code base - functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "VS Code base - variables",
      "scope": [
        "variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Peitian ARL: plain text",
      "scope": [
        "source.arl",
        "variable.other.definition.arl"
      ],
      "settings": {
        "foreground": "#c8d0d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: S1 datatype / logic / keyword",
      "scope": [
        "storage.type.arl",
        "storage.type.return.arl"
      ],
      "settings": {
        "foreground": "#F0A082",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: S1 datatype / logic / keyword",
      "scope": [
        "keyword.control.arl",
        "keyword.other.arl",
        "keyword.declaration.function.arl"
      ],
      "settings": {
        "foreground": "#EEEE00",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: instructions",
      "scope": [
        "support.function.instruction.arl"
      ],
      "settings": {
        "foreground": "#00EEEE",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: built-in functions",
      "scope": [
        "support.function.builtin.arl",
        "support.function.builtin.paren.arl"
      ],
      "settings": {
        "foreground": "#00D407",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: user and cross-file functions",
      "scope": [
        "entity.name.function.user.arl",
        "entity.name.namespace.arl",
        "punctuation.accessor.arl"
      ],
      "settings": {
        "foreground": "#78a8c8",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: main",
      "scope": [
        "entity.name.function.main.arl",
        "support.function.builtin.main.arl"
      ],
      "settings": {
        "foreground": "#ff5555",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: system variables",
      "scope": [
        "variable.language.system.arl"
      ],
      "settings": {
        "foreground": "#C5947C",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: comments",
      "scope": [
        "comment.line.double-slash.arl",
        "punctuation.definition.comment.arl",
        "comment.block.arl",
        "punctuation.definition.comment.begin.arl",
        "punctuation.definition.comment.end.arl"
      ],
      "settings": {
        "foreground": "#49a659",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: strings",
      "scope": [
        "string.quoted.double.arl",
        "punctuation.definition.string.begin.arl",
        "punctuation.definition.string.end.arl"
      ],
      "settings": {
        "foreground": "#9a9a9a",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: numbers",
      "scope": [
        "constant.numeric.arl"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: brackets",
      "scope": [
        "punctuation.section.brackets.arl"
      ],
      "settings": {
        "foreground": "#c96eb4",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: constants",
      "scope": [
        "constant.language.arl"
      ],
      "settings": {
        "foreground": "#B4A0FF",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true
}
