{
  "$schema": "vscode://schemas/color-theme",
  "name": "Peitian ARL Light",
  "type": "light",
  "colors": {
    "foreground": "#000000",
    "descriptionForeground": "#707070",
    "focusBorder": "#0069CC",
    "activityBar.background": "#ececec",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#707070",
    "activityBar.border": "#c8c8c8",
    "sideBar.background": "#ececec",
    "sideBar.foreground": "#000000",
    "sideBar.border": "#c8c8c8",
    "titleBar.activeBackground": "#ececec",
    "titleBar.activeForeground": "#707070",
    "titleBar.border": "#c8c8c8",
    "editor.background": "#f6f6f6",
    "editor.foreground": "#000000",
    "editorLineNumber.foreground": "#90a0b0",
    "editorLineNumber.activeForeground": "#000000",
    "editorCursor.foreground": "#000000",
    "editor.selectionBackground": "#0069CC40",
    "editor.inactiveSelectionBackground": "#0069CC1A",
    "editor.lineHighlightBackground": "#EAEAEA80",
    "editorWhitespace.foreground": "#60606040",
    "editorIndentGuide.background1": "#D8D8D880",
    "editorIndentGuide.activeBackground1": "#A0A0A0",
    "editorBracketMatch.background": "#0069CC40",
    "editorBracketMatch.border": "#F0F1F2",
    "editorGroupHeader.tabsBackground": "#FAFAFD",
    "tab.activeBackground": "#f6f6f6",
    "tab.activeForeground": "#000000",
    "tab.inactiveBackground": "#ececec",
    "tab.inactiveForeground": "#707070",
    "tab.border": "#c8c8c8",
    "panel.background": "#ececec",
    "panel.border": "#c8c8c8",
    "statusBar.background": "#d8d8d8",
    "statusBar.foreground": "#707070",
    "statusBar.border": "#c8c8c8"
  },
  "tokenColors": [
    {
      "name": "VS Code base - comments",
      "scope": "comment",
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "name": "VS Code base - strings",
      "scope": "string",
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "name": "VS Code base - numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#098658"
      }
    },
    {
      "name": "VS Code base - control flow",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#AF00DB"
      }
    },
    {
      "name": "VS Code base - keywords",
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "VS Code base - types",
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type"
      ],
      "settings": {
        "foreground": "#267F99"
      }
    },
    {
      "name": "VS Code base - functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#795E26"
      }
    },
    {
      "name": "VS Code base - variables",
      "scope": [
        "variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "name": "Peitian ARL: plain text",
      "scope": [
        "source.arl",
        "variable.other.definition.arl"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: S1 datatype / logic / keyword",
      "scope": [
        "storage.type.arl",
        "storage.type.return.arl"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: S1 datatype / logic / keyword",
      "scope": [
        "keyword.control.arl",
        "keyword.other.arl",
        "keyword.declaration.function.arl"
      ],
      "settings": {
        "foreground": "#d4860a",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: instructions",
      "scope": [
        "support.function.instruction.arl"
      ],
      "settings": {
        "foreground": "#0000e8",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: built-in functions",
      "scope": [
        "support.function.builtin.arl",
        "support.function.builtin.paren.arl"
      ],
      "settings": {
        "foreground": "#aa00aa",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: user and cross-file functions",
      "scope": [
        "entity.name.function.user.arl",
        "entity.name.namespace.arl",
        "punctuation.accessor.arl"
      ],
      "settings": {
        "foreground": "#1a67a8",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: main",
      "scope": [
        "entity.name.function.main.arl",
        "support.function.builtin.main.arl"
      ],
      "settings": {
        "foreground": "#ff5555",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: system variables",
      "scope": [
        "variable.language.system.arl"
      ],
      "settings": {
        "foreground": "#795e26",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: comments",
      "scope": [
        "comment.line.double-slash.arl",
        "punctuation.definition.comment.arl",
        "comment.block.arl",
        "punctuation.definition.comment.begin.arl",
        "punctuation.definition.comment.end.arl"
      ],
      "settings": {
        "foreground": "#008000",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: strings",
      "scope": [
        "string.quoted.double.arl",
        "punctuation.definition.string.begin.arl",
        "punctuation.definition.string.end.arl"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: numbers",
      "scope": [
        "constant.numeric.arl"
      ],
      "settings": {
        "foreground": "#c0392b",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: brackets",
      "scope": [
        "punctuation.section.brackets.arl"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": ""
      }
    },
    {
      "name": "Peitian ARL: constants",
      "scope": [
        "constant.language.arl"
      ],
      "settings": {
        "foreground": "#244A4A",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true
}
